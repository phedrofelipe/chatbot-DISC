# Groq API Key
GROQ_API_KEY=sua_chave_groq_aqui

# Auth
JWT_SECRET=troque_por_uma_chave_secreta_forte_e_aleatoria

# Administrador inicial (criado automaticamente no primeiro boot do backend)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=defina_uma_senha_forte_aqui

# CORS — URL pública do frontend
FRONTEND_URL=http://localhost

# URL pública da API, usada pelo frontend (embutida no build do Vite).
# Use http://localhost:3000 para acesso local ou http://<ip-da-vm>:3000
# quando o acesso for feito pelo IP/domínio do servidor.
VITE_API_URL=http://localhost:3000

# Database (PostgreSQL — único motor suportado)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=chatbot_disc
